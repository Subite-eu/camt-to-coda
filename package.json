{
  "name": "camt2coda",
  "version": "2.0.0",
  "description": "CAMT to CODA bank statement converter",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "camt2coda": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp src/web/index.html dist/web/index.html",
    "build:web": "vite build",
    "build:app": "vite build",
    "dev": "tsx src/cli.ts",
    "dev:app": "vite",
    "dev:web": "npm run build:app && npx -y serve dist-web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json"
  },
  "keywords": [
    "camt",
    "coda",
    "iso20022",
    "bank-statement",
    "converter"
  ],
  "author": "Subite",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-toggle-group": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "fast-xml-parser": "^5.5.7",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1009.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.0",
    "esbuild": "^0.28.1",
    "fast-check": "^3.22.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite": "^8.1.2",
    "vitest": "^4.1.0"
  }
}
