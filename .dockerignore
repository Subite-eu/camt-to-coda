# Only build inputs enter the Docker context; exclude private bank examples,
# repository history, credentials, dependencies and local audit artifacts.
*
!package.json
!package-lock.json
!tsconfig*.json
!vite.config.ts
!src/
!src/**
!examples/catalog.json
!examples/download-catalog.json
!examples/bank-published/catalog.json
!examples/bank-catalog/catalog.json
!examples/bank-catalog/country-references.json
!examples/camt/*.xml
!examples/coda/*.cod
!examples/invalid/*.xml
!examples/invalid/*.cod
